{
    "name": "coolms/field-bundle",
    "description": "Symfony integration for coolms/field: the bundle and its extension, the field-definition API Platform surface, the console commands, form types, validation registry and the override storage router",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "coolms",
        "field",
        "symfony-bundle",
        "api-platform",
        "dynamic-fields"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "support": {
        "issues": "https://github.com/coolms/field-bundle/issues",
        "source": "https://github.com/coolms/field-bundle"
    },
    "require": {
        "php": "^8.5",
        "ext-simplexml": "*",
        "api-platform/core": "^4.1",
        "coolms/core": "^2.0.0-alpha4",
        "coolms/core-bundle": "^2.0.0-alpha7",
        "coolms/core-application": "^2.0.0-alpha3",
        "coolms/entity": "^2.0.0-alpha5",
        "coolms/entity-bundle": "^2.0.0-alpha6",
        "coolms/field": "^2.0.0-alpha2",
        "coolms/field-doctrine": "^2.0.0-alpha2",
        "psr/log": "^3.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/form": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "coolms/core-doctrine": "^2.0",
        "coolms/entity-doctrine": "^2.0",
        "doctrine/doctrine-bundle": "^3.2",
        "phpunit/phpunit": "^12.5",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client-contracts": "^3.5",
        "symfony/translation": "^8.0",
        "symfony/var-dumper": "^7.4|^8.0",
        "symfony/web-link": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Field\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Field\\Bundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
