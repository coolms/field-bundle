{
    "name": "coolms/field-bundle",
    "description": "Symfony integration for coolms/field: the bundle and its extension, the field-definition API Platform surface, the console commands, form types, validation registry and the override storage router",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "coolms",
        "field",
        "symfony-bundle",
        "api-platform",
        "dynamic-fields"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "require": {
        "php": "^8.5",
        "api-platform/core": "^4.1",
        "coolms/core": "^2.0",
        "coolms/core-bundle": "^2.0",
        "coolms/core-app": "^2.0",
        "coolms/entity": "^2.0",
        "coolms/entity-bundle": "^2.0",
        "coolms/field": "^2.0",
        "coolms/field-doctrine": "^2.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/form": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\FieldBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\FieldBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
